# 复制为 .env 并填写(可选,仅当 nginx 启用了 basic auth 时需要)
BASIC_AUTH_USER=youruser
BASIC_AUTH_PASSWORD=change-me

# LiteGate AI 网关(提示词助手「AI 润色/翻译」+ 批量生成「AI 细化提示词」)
# LITEGATE_BASE=https://192.168.x.x:29007/v1
# LITEGATE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LITEGATE_API_KEY=sk-xxx
# 网关用自签证书时打开(跳过证书校验,仅限内网)
# LITEGATE_INSECURE=1

# ComfyUI 主机的 GPU 温度/利用率跨机采集(批量生成页与设置页展示):
# GPU 主机开启 SSH 并部署本机公钥后配置,如 COMFY_SSH=youruser@192.168.x.x
# COMFY_SSH=

# 批量生成引擎的 GPU 温度保护(默认关)。
# 仅当本服务与 ComfyUI 同在一台 GPU 主机时才有意义(温度经本机 nvidia-smi 读取);
# ≥72°C 休 60s、≥78°C 休 180s 后继续。
# BATCHGEN_GPU_TEMP=1
