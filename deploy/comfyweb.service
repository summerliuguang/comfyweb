[Unit]
Description=ComfyWeb - ComfyUI 简易生成站
After=network.target

# 部署模板:按实际用户与路径修改 User / WorkingDirectory / ExecStart 后再安装
# (cp 到 /etc/systemd/system/comfyweb.service 后 systemctl daemon-reload && systemctl enable --now comfyweb)

[Service]
Type=simple
User=youruser
WorkingDirectory=/opt/comfyweb
Environment=PORT=5012
ExecStart=/opt/comfyweb/venv/bin/python /opt/comfyweb/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
